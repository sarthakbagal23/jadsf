# Copy this file to .env and fill in what you use. Everything is optional —
# the local Ollama brain works with nothing here. Each integration turns on
# the moment its keys exist; missing keys just disable that plugin.

# --- brain (pick one or leave blank for local Ollama) ---
# Groq: free tier, no card. console.groq.com -> API Keys (starts gsk_)
GROQ_API_KEY=
# "auto" = Groq if key set, else Ollama, else OpenRouter. Or "groq"/"ollama".
EDITH_BRAIN=auto
# OpenRouter fallback: openrouter.ai/keys (free models end in :free)
OPENROUTER_API_KEY=

# --- computer use: OFF unless 1 (it can click anything) ---
EDITH_COMPUTER_USE=
# Vision model for see_screen (Groq free tier, multimodal):
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- voice ---
# Picovoice: console.picovoice.ai (free tier)
PICOVOICE_ACCESS_KEY=

# --- Notion: notion.so/my-integrations -> New integration -> secret ---
NOTION_API_KEY=

# --- Spotify: developer.spotify.com -> app -> Client ID + Secret ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Run: python -m integrations.spotify_auth (once) to get this:
SPOTIFY_REFRESH_TOKEN=

# --- GitHub: github.com/settings/tokens -> classic token, `repo` scope ---
GITHUB_TOKEN=

# --- Discord: discord.com/developers -> Bot -> token ---
DISCORD_BOT_TOKEN=

# --- Google: download OAuth client JSON as credentials.json (see README) ---
# (no .env key needed — credentials.json + token.json in this folder)

# --- school (read-only) ---
# Canvas: Account > Settings > "+ New Access Token". Base URL = your Canvas site.
CANVAS_BASE_URL=
CANVAS_TOKEN=
# Infinite Campus: your portal host, then run once:  python -m integrations.school ic-login
IC_BASE_URL=
CLASSLINK_URL=https://launchpad.classlink.com/
STUDENT_SUPPORT_TIME_URL=https://forsyth.studentsupporttime.com/SHome
# Optional. Set only after launching Chrome with remote debugging enabled.
EDITH_CHROME_CDP_URL=http://127.0.0.1:9222

# --- phone/browser server: local-only by default. To open it up, set BOTH: ---
# EDITH_HOST=0.0.0.0
# EDITH_TOKEN=pick-a-long-random-string

EDITH_CITY=Cumming
EDITH_NAME=Even Dead, I'm The Hero
EDITH_WAKE_WORD=edith

# --- agent (browser + laptop control) ---
# How much EDITH talks while working: off | key (start, approvals, results) | all
EDITH_NARRATE=key
# Steps a browser task may take before giving up
EDITH_AGENT_STEPS=25
# School tasks only ever use a LOCAL model. A 3B model is weak at driving a browser;
# an 8B+ one is much better:  ollama pull llama3.1:8b   (or qwen2.5:7b)
EDITH_LOCAL_AGENT_MODEL=llama3.1:8b
# Phone push notifications via ntfy.sh (install the ntfy app, subscribe to this topic).
# Pushes are always generic ("EDITH needs your approval") - details stay on the laptop.
EDITH_NTFY_TOPIC=
